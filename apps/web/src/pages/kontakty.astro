---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import { getSettings } from '../lib/payload'
import { url } from '../lib/url'

const settings = await getSettings()
const { contacts } = settings
const tel = contacts.phone?.replace(/\s|\(|\)|-/g, '') || ''
---
<Base title="Контакти" description="Телефон, адреса та форма зв'язку WonderCake.">
  <PageHero eyebrow="Контакти" title="Зв'яжіться з нами" text="Відповідаємо у робочі години зазвичай за 10–15 хвилин." />

  <section class="section">
    <div class="container-page grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="space-y-4">
        {contacts.phone && (
          <a href={`tel:${tel}`} class="card flex items-center gap-4 p-5 transition hover:shadow-[var(--shadow-lift)]">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-primary-soft text-xl">📞</span>
            <span>
              <span class="block text-xs font-semibold uppercase tracking-wide text-navy-soft">Телефон</span>
              <span class="text-lg font-extrabold">{contacts.phone}</span>
            </span>
          </a>
        )}
        {contacts.email && (
          <a href={`mailto:${contacts.email}`} class="card flex items-center gap-4 p-5 transition hover:shadow-[var(--shadow-lift)]">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-accent-soft text-xl">✉️</span>
            <span>
              <span class="block text-xs font-semibold uppercase tracking-wide text-navy-soft">Email</span>
              <span class="text-lg font-extrabold">{contacts.email}</span>
            </span>
          </a>
        )}
        <div class="card flex items-center gap-4 p-5">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-primary-soft text-xl">📍</span>
          <span>
            <span class="block text-xs font-semibold uppercase tracking-wide text-navy-soft">Адреса</span>
            <span class="text-lg font-extrabold">{contacts.address}</span>
            <span class="block text-sm text-navy-soft">{contacts.schedule}</span>
          </span>
        </div>

        {settings.delivery && settings.delivery.length > 0 && (
          <div class="card p-5">
            <h2 class="text-lg font-extrabold">Доставка та самовивіз</h2>
            <dl class="mt-3 space-y-2.5 text-sm">
              {settings.delivery.map((item) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-navy-soft">{item.title}</dt>
                  <dd class="text-right font-semibold">{item.text}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {settings.socials && settings.socials.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {settings.socials.map((social) => (
              <a href={social.href} target="_blank" rel="noopener" class="btn btn-outline text-sm">{social.label}</a>
            ))}
          </div>
        )}
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="text-xl font-extrabold">Розрахувати торт</h2>
        <p class="mt-2 text-sm text-navy-soft">Опишіть ідею — кондитер порахує вартість і передзвонить.</p>

        <div data-contact-sent hidden class="mt-6 rounded-2xl bg-accent-soft p-5 text-center">
          <p class="text-3xl">🎉</p>
          <p class="mt-2 font-bold">Дякуємо, заявку прийнято!</p>
          <p class="mt-1 text-sm text-navy-soft">Це демо-версія: повідомлення нікуди не надсилається.</p>
        </div>
        <form data-contact-form class="mt-6 space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold">Ім'я</span>
              <input type="text" name="name" required class="mt-1.5 w-full rounded-2xl border border-navy/12 bg-cream px-4 py-3 outline-none focus:border-primary" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold">Телефон</span>
              <input type="tel" name="phone" required placeholder="+380…" class="mt-1.5 w-full rounded-2xl border border-navy/12 bg-cream px-4 py-3 outline-none focus:border-primary" />
            </label>
          </div>
          <label class="block">
            <span class="text-sm font-semibold">Дата свята</span>
            <input type="date" name="date" class="mt-1.5 w-full rounded-2xl border border-navy/12 bg-cream px-4 py-3 outline-none focus:border-primary" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold">Опис замовлення</span>
            <textarea name="message" rows="4" placeholder="Скільки гостей, які смаки, який декор…" class="mt-1.5 w-full rounded-2xl border border-navy/12 bg-cream px-4 py-3 outline-none focus:border-primary"></textarea>
          </label>
          <button type="submit" class="btn btn-primary w-full py-4">Надіслати заявку</button>
          <p class="text-center text-xs text-navy-soft">Натискаючи кнопку, ви погоджуєтесь з <a href={url('/polityka')} class="underline">політикою конфіденційності</a>.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // Сервера немає — просто показуємо подяку замість форми
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    form.hidden = true
    document.querySelector<HTMLElement>('[data-contact-sent]')!.hidden = false
  })
</script>
