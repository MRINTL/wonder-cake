---
import { MENU } from '../lib/nav'
import type { SettingsGlobal } from '../lib/payload'
import { pagePath, url } from '../lib/url'

type Props = { settings: SettingsGlobal }
const { settings } = Astro.props
const path = pagePath(Astro.url.pathname)
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href))
---
<header class="sticky top-0 z-50 border-b border-navy/8 bg-cream/85 backdrop-blur-md">
  <div class="container-page">
    <div class="flex h-16 items-center gap-1.5 sm:gap-3 lg:h-20 lg:gap-7">
      <button type="button" class="-ml-2 grid size-11 shrink-0 place-items-center rounded-full text-navy hover:bg-primary-soft lg:hidden" data-menu-open aria-label="Відкрити меню">
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h10" />
        </svg>
      </button>

      <a href={url('/')} aria-label={`${settings.siteName} — на головну`} class="flex shrink-0 items-center">
        <img src={url('/logo.svg')} alt={settings.siteName} width="94" height="56" class="h-11 w-auto lg:h-14" />
      </a>

      <nav aria-label="Головне меню" class="hidden flex-1 justify-center gap-5 lg:flex xl:gap-6">
        {MENU.map((item) => (
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`whitespace-nowrap text-[15px] transition hover:text-primary ${isActive(item.href) ? 'font-bold text-primary' : 'font-semibold text-navy'}`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="ml-auto flex shrink-0 items-center">
        <button type="button" class="grid size-10 place-items-center rounded-full text-navy transition hover:bg-primary-soft hover:text-primary lg:size-11" data-search-open aria-label="Пошук">
          <svg viewBox="0 0 24 24" class="size-5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
        </button>

        <a href={url('/vhid')} class="hidden size-11 place-items-center rounded-full text-navy transition hover:bg-primary-soft hover:text-primary lg:grid" aria-label="Особистий кабінет">
          <svg viewBox="0 0 24 24" class="size-5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" />
          </svg>
        </a>

        <a href={url('/obrane')} class="relative grid size-10 place-items-center rounded-full text-navy transition hover:bg-primary-soft hover:text-primary lg:size-11" aria-label="Обране">
          <svg viewBox="0 0 24 24" class="size-5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" />
          </svg>
          <span data-fav-count class="absolute right-0 top-0.5 hidden min-w-[18px] rounded-full border-2 border-cream bg-accent px-1 text-center text-[11px] font-extrabold leading-[14px] text-navy"></span>
        </a>

        <a href={url('/koshyk')} class="relative grid size-10 place-items-center rounded-full text-navy transition hover:bg-primary-soft hover:text-primary lg:size-11" aria-label="Кошик">
          <svg viewBox="0 0 24 24" class="size-5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" />
          </svg>
          <span data-cart-count class="absolute right-0 top-0.5 hidden min-w-[18px] rounded-full border-2 border-cream bg-primary px-1 text-center text-[11px] font-extrabold leading-[14px] text-white"></span>
        </a>
      </div>
    </div>
  </div>

  <!-- Пошук -->
  <div data-search-panel hidden class="border-t border-navy/8 bg-white">
    <form action={url('/poshuk')} method="get" class="container-page flex items-center gap-2 py-3">
      <div class="relative flex-1">
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-navy-soft" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <input type="search" name="q" data-search-input placeholder="Торт, пончики, макарони…" class="w-full rounded-full border border-navy/12 bg-cream py-3 pl-12 pr-4 text-[15px] outline-none focus:border-primary" />
      </div>
      <button type="submit" class="btn btn-primary py-3">Знайти</button>
      <button type="button" class="btn btn-ghost px-2 py-3" data-search-close aria-label="Закрити">✕</button>
    </form>
  </div>
</header>

<!-- Мобільне меню -->
<div data-menu-panel hidden class="fixed inset-0 z-60 lg:hidden">
  <div class="absolute inset-0 bg-navy/40 backdrop-blur-sm" data-menu-close></div>
  <nav class="absolute inset-y-0 left-0 flex w-[86%] max-w-sm flex-col bg-white p-5 shadow-2xl">
    <div class="flex items-center justify-between">
      <img src={url('/logo.svg')} alt={settings.siteName} width="94" height="56" class="h-11 w-auto" />
      <button type="button" class="grid size-10 place-items-center rounded-full hover:bg-primary-soft" data-menu-close aria-label="Закрити">✕</button>
    </div>
    <div class="mt-6 flex flex-col">
      {MENU.map((item) => (
        <a href={url(item.href)} class={`border-b border-navy/8 py-3.5 text-lg font-bold ${isActive(item.href) ? 'text-primary' : ''}`}>{item.label}</a>
      ))}
    </div>
    <div class="mt-6 flex flex-col gap-2">
      <a href={url('/obrane')} class="btn btn-outline">Обране</a>
      <a href={url('/koshyk')} class="btn btn-primary">Кошик</a>
      <a href={url('/vhid')} class="btn btn-ghost">Особистий кабінет</a>
    </div>
    {settings.contacts?.phone && (
      <a href={`tel:${settings.contacts.phone.replace(/\s|\(|\)|-/g, '')}`} class="mt-auto pt-6 text-lg font-extrabold text-primary">{settings.contacts.phone}</a>
    )}
  </nav>
</div>
