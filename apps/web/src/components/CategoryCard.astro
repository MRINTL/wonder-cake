---
import type { Category } from '../lib/payload'
import { plural } from '../lib/format'
import ProductImage from './ProductImage.astro'
import { url } from '../lib/url'

type Props = { category: Category; count?: number }
const { category, count } = Astro.props
---
<a href={url(`/katalog?kategoriya=${category.slug}`)} class="card group flex flex-col overflow-hidden transition-shadow hover:shadow-[var(--shadow-lift)]">
  <div class="aspect-4/3 overflow-hidden">
    <ProductImage shape={category.shape} seed={category.order ?? 0} alt={category.title} class="transition-transform duration-500 group-hover:scale-105" />
  </div>
  <div class="p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-base font-bold group-hover:text-primary sm:text-lg">{category.title}</h3>
      <span class="text-primary transition-transform group-hover:translate-x-1">→</span>
    </div>
    <p class="mt-1 line-clamp-2 text-sm text-navy-soft">{category.description}</p>
    {count !== undefined && (
      <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-accent">
        {count} {plural(count, 'позиція', 'позиції', 'позицій')}
      </p>
    )}
  </div>
</a>
