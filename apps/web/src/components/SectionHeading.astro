---
type Props = { eyebrow?: string; title: string; text?: string; align?: 'left' | 'center'; class?: string }
const { eyebrow, title, text, align = 'left', class: className = '' } = Astro.props
---
<header class={`${align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-2xl'} ${className}`}>
  {eyebrow && <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>}
  <h2 class="text-2xl font-extrabold sm:text-3xl lg:text-4xl">{title}</h2>
  {text && <p class="mt-3 text-[15px] leading-relaxed text-navy-soft sm:text-base">{text}</p>}
</header>
