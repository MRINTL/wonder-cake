---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import ContentSections from '../components/ContentSections.astro'
import ProductImage from '../components/ProductImage.astro'
import { getHome, getPage } from '../lib/payload'
import { formatNumber } from '../lib/format'

const [page, home] = await Promise.all([getPage('pro-nas'), getHome()])

const stats = [
  { value: formatNumber(home.counters.donuts), label: home.counters.donutsLabel },
  { value: formatNumber(home.counters.cakesKg), label: home.counters.cakesLabel },
  { value: formatNumber(home.counters.years || 0), label: home.counters.yearsLabel },
].filter((item) => item.label)
---
<Base title={page?.title || 'Про нас'} description={page?.intro}>
  <PageHero eyebrow="Про нас" title={page?.title || 'Про нас'} text={page?.intro} />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
        <ContentSections sections={page?.sections} />

        <aside class="space-y-4">
          <div class="overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-soft)]">
            <div class="aspect-square"><ProductImage shape="donut" seed={1} alt="Наш цех" /></div>
          </div>
          <dl class="grid gap-3">
            {stats.map((stat) => (
              <div class="card flex items-baseline justify-between gap-3 p-4">
                <dt class="text-2xl font-extrabold text-primary">{stat.value}</dt>
                <dd class="text-right text-xs font-semibold text-navy-soft">{stat.label}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <div class="grid gap-4 sm:grid-cols-3">
        {[
          { icon: '🥚', title: 'Тільки свіже', text: 'Яйця, вершки та ягоди приймаємо щоранку. Заморожених напівфабрикатів у цеху немає.' },
          { icon: '📋', title: 'Прозорий склад', text: 'Пишемо повний склад і алергени на кожній сторінці товару — без «ароматизаторів, ідентичних натуральним».' },
          { icon: '🤝', title: 'Передзвонюємо', text: 'Якщо щось пішло не так — компенсуємо вартість того ж дня, без листування місяцями.' },
        ].map((item) => (
          <div class="card p-6">
            <p class="text-3xl">{item.icon}</p>
            <h3 class="mt-3 text-lg font-extrabold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-soft">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
