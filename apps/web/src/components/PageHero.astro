---
import { plural } from '../lib/format'

type Props = { eyebrow?: string; title: string; text?: string; count?: number }
const { eyebrow, title, text, count } = Astro.props
---
<section class="border-b border-navy/8 bg-linear-to-b from-accent-soft/60 to-cream">
  <div class="container-page py-8 sm:py-12">
    {eyebrow && <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>}
    <h1 data-hero-title class="mt-2 text-3xl font-extrabold sm:text-4xl lg:text-5xl">{title}</h1>
    {text && <p data-hero-text class="mt-3 max-w-2xl text-[15px] leading-relaxed text-navy-soft sm:text-base">{text}</p>}
    {count !== undefined && (
      <p data-hero-count class="mt-4 text-sm font-semibold text-navy-soft">
        {count} {plural(count, 'позиція', 'позиції', 'позицій')} у наявності
      </p>
    )}
  </div>
</section>
